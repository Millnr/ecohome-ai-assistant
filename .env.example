# ── Flowise ────────────────────────────────────────────────────────────────────
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=changeme

# Get from Flowise UI → API Keys after first launch
FLOWISE_API_KEY=

# The Flowise chatflow ID for the EcoHome RAG pipeline
# Get from Flowise UI → Chatflows → copy the ID from the URL
FLOWISE_CHATFLOW_ID=

# ── Anthropic ──────────────────────────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Langfuse ───────────────────────────────────────────────────────────────────
# https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Local dev overrides ────────────────────────────────────────────────────────
# Uncomment when running api locally (not via Docker)
# FLOWISE_URL=http://localhost:3000
# REDIS_URL=redis://localhost:6379
